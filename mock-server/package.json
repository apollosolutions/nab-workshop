{
  "name": "nab-workshop-mock-server",
  "private": true,
  "version": "0.0.0",
  "description": "Apollo Server that auto-mocks the approved proposal's schema via @graphql-tools/mock",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.0"
  },
  "scripts": {
    "build": "tsc",
    "postinstall": "pnpm build",
    "start": "node dist/index.js",
    "dev": "nodemon --watch \"src/**\" --watch \"./schema.graphql\" --ext \"ts,json,graphql\" --exec \"pnpm build && pnpm start\"",
    "dev:fresh": "pnpm fetch-schema && pnpm dev",
    "fetch-schema": "./fetch-schema.sh"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@graphql-tools/mock": "^9.0.0",
    "@graphql-tools/schema": "^10.0.0",
    "graphql": "latest",
    "graphql-tag": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "nodemon": "^3.0.0",
    "typescript": "^5.9.2"
  }
}
