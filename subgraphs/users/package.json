{
  "name": "nab-workshop-users",
  "private": true,
  "version": "0.0.0",
  "description": "Users subgraph for the NAB workshop. Backed by DummyJSON.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.0"
  },
  "scripts": {
    "build": "tsc",
    "postinstall": "pnpm build",
    "start": "node dist/index.js",
    "dev": "nodemon --watch \"src/**\" --ext \"ts,json,graphql\" --exec \"pnpm build && pnpm start\""
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@apollo/subgraph": "^2.3.1",
    "graphql": "latest",
    "graphql-tag": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "nodemon": "^3.0.0",
    "typescript": "^5.9.2"
  }
}
